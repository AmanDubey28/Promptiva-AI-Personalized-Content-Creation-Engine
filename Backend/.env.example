# Environment Configuration for Promptiva Backend

# Database Configuration
# For SQLite: sqlite:///./promptiva.db
# For PostgreSQL: postgresql://user:password@localhost:5432/promptiva_db
DATABASE_URL=sqlite:///./promptiva.db

# Frontend URL (for CORS)
# Local development: http://localhost:5173,http://localhost:5174
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# JWT Secret Key (generate a strong random key)
# Example: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Keys for AI Models
# Gemini API Key (get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API Key (get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Server Configuration
HOST=127.0.0.1
PORT=8000
